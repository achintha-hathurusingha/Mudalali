# --- Understanding layer -----------------------------------------------
# gemini | claude  - swap with one line, the pipeline does not care
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.8-flash
# gemini-3.5-flash-lite is cheaper and faster if accuracy holds on your traffic

# Only needed if LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5

# --- Memory ------------------------------------------------------------
DATABASE_URL=postgresql://user:pass@host:5432/postgres

# Managed Postgres (Aiven, Supabase, Neon) uses a CA the system store does not
# know. Point this at the provider's CA file so TLS is actually verified - this
# database holds customer names, phone numbers and addresses.
# DATABASE_CA_CERT=./ca.pem

# --- Channel -----------------------------------------------------------
CHANNEL=baileys           # baileys | console
WA_AUTH_DIR=./.wa-auth

# Your own number(s) in JID form - drafts and alerts come here.
# Comma-separated. Baileys 7 sometimes delivers messages under an @lid JID,
# which is NOT derived from the phone number: if your commands stop being
# recognised, check the logs for the sender JID and add it here too.
OPERATOR_WA_JID=94771234567@s.whatsapp.net

# --- Rollout policy ----------------------------------------------------
# Start on suggest. Move to auto only after you have watched a few hundred messages.
POLICY_MODE=suggest
AUTO_INTENTS=greeting,availability,delivery,payment
MIN_CONFIDENCE=0.8
HISTORY_TURNS=10

# People send one thought as three messages. Wait this long for the rest
# before running the model, so one intent costs one call and one draft.
# Set to 0 to process every message immediately (useful with CHANNEL=console).
DEBOUNCE_MS=5000

# Send the model's holding line to the customer the moment something is
# escalated, rather than leaving them in silence until you reply.
AUTO_ACK_ESCALATIONS=true

LOG_LEVEL=info
