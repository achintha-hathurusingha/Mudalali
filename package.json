{
  "name": "mudalali",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An AI shopkeeper for WhatsApp - reads Singlish, drafts the reply, captures the order, and never sends anything without you.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "db:setup": "tsx scripts/setup-db.ts",
    "db:seed": "tsx scripts/seed-catalog.ts",
    "console": "cross-env CHANNEL=console tsx src/index.ts",
    "try": "tsx scripts/try.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "node --import tsx --test tests/pipeline.test.ts",
    "test:cx": "tsx tests/live-cx.ts",
    "test:e2e": "tsx tests/e2e.ts",
    "fixtures": "tsx tests/make-fixtures.ts",
    "test:media": "tsx tests/live-media.ts",
    "photos": "tsx tests/make-photos.ts",
    "test:photos": "tsx tests/test-photos.ts",
    "db:settings": "tsx scripts/seed-settings.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@google/genai": "^2.21.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@bytebase/dbhub": "^1.2.3",
    "@hapi/boom": "^10.0.1",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "chrome-devtools-mcp": "^1.9.0",
    "cross-env": "^10.1.0",
    "pg-mem": "^3.0.14",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
