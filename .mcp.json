{
  "mcpServers": {
    "db": {
      "type": "stdio",
      "command": "node",
      "args": [
        "node_modules/@bytebase/dbhub/dist/index.js",
        "--transport",
        "stdio",
        "--config",
        "./dbhub.toml"
      ],
      "env": {}
    },
    "chrome": {
      "type": "stdio",
      "command": "node",
      "args": [
        "node_modules/chrome-devtools-mcp/build/src/bin/chrome-devtools-mcp.js"
      ],
      "env": {}
    },
    "shadcn": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "shadcn@latest",
        "mcp"
      ],
      "env": {}
    }
  }
}
